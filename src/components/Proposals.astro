---
import { copyFor } from "../content/site";
import { publicUrl } from "../lib/paths";
import Title from "./Title.astro";

const site = copyFor(Astro.currentLocale);
const { proposals } = site;
const product = (id: string, ext: string) => publicUrl(`media/products/${id}.${ext}`);
---

<section class="section band" id={proposals.id} aria-labelledby="propuestas-titulo">
  <div class="wrap">
    <Title id="propuestas-titulo" heading={proposals.title} />
    <ul class="proposal-tiles" data-reveal-group>
      {
        proposals.items.map((item) => (
          <li class="proposal">
            <span class="proposal-tile">
              <picture>
                <source srcset={product(item.id, "avif")} type="image/avif" />
                <source srcset={product(item.id, "webp")} type="image/webp" />
                <img src={product(item.id, "png")} alt={item.alt} width="720" height="720" loading="lazy" decoding="async" />
              </picture>
            </span>
            <span class="proposal-name">{item.name}</span>
          </li>
        ))
      }
    </ul>
    <p class="band-note">{proposals.note}</p>
  </div>
</section>
