---
import { site } from "../content/site";
import Title from "./Title.astro";

const { steps } = site;
---

<section class="section" id={steps.id} aria-labelledby="como-funciona-titulo">
  <div class="wrap">
    <Title id="como-funciona-titulo" heading={steps.title} />
    <ol class="steps" data-reveal-group>
      {
        steps.items.map((item, index) => (
          <li class="step">
            <span class="step-n">{String(index + 1).padStart(2, "0")}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
