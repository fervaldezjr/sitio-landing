---
import { site } from "../content/site";
import { hashHref, publicUrl } from "../lib/paths";
import StoreBadges from "./StoreBadges.astro";

/*
 * The first screen is a pinned stage (docs/identity.md, dial 5): the phone stays in the middle
 * and its screen changes with the scroll, in the order the app is used. story.ts drives it.
 * Without JavaScript, or with reduced motion, it is a still: the mirror, its card and the steps as a list.
 */
const { story } = site;
const { phone } = story;
const tall = [432, 648, 864];

function srcset(name: string, ext: string): string {
  return tall.map((width) => `${publicUrl(`media/hero/${name}-${width}.${ext}`)} ${width}w`).join(", ");
}

function product(id: string, ext: string): string {
  return publicUrl(`media/products/${id}.${ext}`);
}

const sizes = "(min-width: 761px) 320px, 62vw";
---

<section class="story" id="top" aria-labelledby="story-title" data-story>
  <div class="story-stage" data-story-stage>
    <div class="story-copy">
      <div class="story-intro" data-story-intro>
        <h1 id="story-title" class="story-title">{story.title}</h1>
        <p class="story-lede">{story.lede}</p>
        <a class="pill-button" href={hashHref(story.cta.href)}>{story.cta.label}</a>
        <StoreBadges />
      </div>
      <ol class="story-steps" data-story-steps>
        {
          story.steps.map((step, index) => (
            <li class="story-step" data-story-step={index}>
              <span class="story-step-n">{String(index + 1).padStart(2, "0")}</span>
              <span class="story-step-title">{step.title}</span>
              <span class="story-step-body">{step.body}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="phone" data-phone>
      <div class="phone-screen">
        <picture class="screen-layer screen-antes">
          <source type="image/avif" sizes={sizes} srcset={srcset("tall-antes", "avif")} />
          <source type="image/webp" sizes={sizes} srcset={srcset("tall-antes", "webp")} />
          <img src={publicUrl("media/hero/tall-antes-648.jpg")} srcset={srcset("tall-antes", "jpg")} sizes={sizes} alt={story.antesAlt} width="864" height="1152" fetchpriority="high" decoding="async" />
        </picture>
        <picture class="screen-layer screen-espejo" data-screen-espejo>
          <source type="image/avif" sizes={sizes} srcset={srcset("tall-espejo", "avif")} />
          <source type="image/webp" sizes={sizes} srcset={srcset("tall-espejo", "webp")} />
          <img src={publicUrl("media/hero/tall-espejo-648.jpg")} srcset={srcset("tall-espejo", "jpg")} sizes={sizes} alt={story.espejoAlt} width="864" height="1152" decoding="async" />
        </picture>
        <span class="screen-edge" data-screen-edge aria-hidden="true"></span>
        <span class="screen-scan" data-screen-scan aria-hidden="true"></span>
        <span class="screen-flash" data-screen-flash aria-hidden="true"></span>

        <div class="screen-camera" data-screen-camera aria-hidden="true">
          <span class="screen-frame"></span>
          <span class="screen-shutter"><span></span></span>
        </div>

        <p class="screen-pill screen-pill-left" data-screen-antes>{phone.antes}</p>
        <p class="screen-pill screen-pill-right" data-screen-espejo-pill>{phone.espejo}</p>
        <p class="screen-pill screen-status" data-screen-status>{phone.status}</p>

        <div class="screen-card" data-screen-card>
          <div class="screen-card-head">
            <p class="screen-card-title">{phone.cardTitle}</p>
            <p class="screen-card-meta">{phone.cardMeta}</p>
          </div>
          {
            phone.rows.map((row) => (
              <div class="screen-row">
                <span class="screen-icon" aria-hidden="true">
                  {row.icon === "remove" && (
                    <svg viewBox="0 0 14 14">
                      <path d="M3 7 H11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                    </svg>
                  )}
                  {row.icon === "add" && (
                    <svg viewBox="0 0 14 14">
                      <path d="M7 3 V11 M3 7 H11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                    </svg>
                  )}
                  {row.icon === "lock" && (
                    <svg viewBox="0 0 14 14">
                      <rect x="3" y="6" width="8" height="6" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.4" />
                      <path d="M5 6 V4.5 a2 2 0 0 1 4 0 V6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
                    </svg>
                  )}
                </span>
                <p>
                  <strong>{row.title}</strong>
                  <span>{row.detail}</span>
                </p>
              </div>
            ))
          }
        </div>

        <div class="screen-sheet" data-screen-sheet>
          <span class="screen-grabber" aria-hidden="true"></span>
          <p class="screen-sheet-title">{phone.listTitle}</p>
          <p class="screen-sheet-meta">{phone.listMeta}</p>
          <ul class="screen-list">
            {
              story.products.map((item, index) => (
                <li class="screen-list-row">
                  <picture>
                    <source srcset={product(item.id, "avif")} type="image/avif" />
                    <source srcset={product(item.id, "webp")} type="image/webp" />
                    <img src={product(item.id, "png")} alt="" width="96" height="96" loading="lazy" decoding="async" />
                  </picture>
                  <span>{phone.listItems[index]}</span>
                  <span class="screen-plus" aria-hidden="true" />
                </li>
              ))
            }
          </ul>
          <p class="screen-sheet-button" data-screen-button>
            <span data-screen-button-add>{phone.listAdd}</span>
            <span data-screen-button-added>{phone.listAdded}</span>
          </p>
        </div>
      </div>
      <span class="phone-island" aria-hidden="true"></span>
    </div>

    <ul class="story-removed" aria-hidden="true" data-story-removed>
      {story.removed.map((name) => <li><span>{name}</span></li>)}
    </ul>

    <ul class="story-products" data-story-products>
      {
        story.products.map((item) => (
          <li class="product-tile">
            <span class="product-name">{item.name}</span>
            <picture>
              <source srcset={product(item.id, "avif")} type="image/avif" />
              <source srcset={product(item.id, "webp")} type="image/webp" />
              <img src={product(item.id, "png")} alt="" width="320" height="320" loading="lazy" decoding="async" />
            </picture>
            <span class="product-plus" aria-hidden="true" />
          </li>
        ))
      }
    </ul>

    <ol class="story-progress" aria-hidden="true" data-story-progress>
      {story.steps.map(() => <li />)}
    </ol>
  </div>
</section>

<script>
  import { initStory } from "../scripts/story";
  initStory();
</script>
