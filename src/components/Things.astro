---
import { site } from "../content/site";
import { publicUrl } from "../lib/paths";
---

<section class="section" id={site.things.id} aria-labelledby="mis-cosas-titulo">
  <div class="section-inner">
    <h2 id="mis-cosas-titulo">{site.things.title}</h2>
    <p class="lede">{site.things.intro}</p>
    <div class="things-grid">
      {
        site.things.items.map((item, index) => (
          <button
            class:list={["thing", index === 0 && "thing-featured"]}
            type="button"
            data-thing
            data-name={item.name}
            data-action={item.action}
            data-detail={item.detail}
            aria-haspopup="dialog"
            aria-label={`${item.name}, ${item.action}. ${site.things.openHint}`}
          >
            <span class="thing-media">
              <picture>
                <source srcset={publicUrl(`media/things/${item.id}.avif`)} type="image/avif" />
                <source srcset={publicUrl(`media/things/${item.id}.webp`)} type="image/webp" />
                <img src={publicUrl(`media/things/${item.id}.jpg`)} alt={item.alt} width="640" height="640" loading="lazy" decoding="async" />
              </picture>
            </span>
            <span class="thing-copy">
              <strong>{item.name}</strong>
              <span>{item.action}</span>
            </span>
          </button>
        ))
      }
    </div>
  </div>
</section>

<dialog class="sheet" data-sheet aria-labelledby="sheet-title">
  <div class="sheet-panel">
    <div class="grabber" aria-hidden="true"></div>
    <h3 id="sheet-title" data-sheet-title></h3>
    <p class="sheet-action" data-sheet-action></p>
    <p data-sheet-detail></p>
    <button class="button" type="button" data-sheet-close>{site.things.close}</button>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-sheet]");
  const title = document.querySelector<HTMLElement>("[data-sheet-title]");
  const action = document.querySelector<HTMLElement>("[data-sheet-action]");
  const detail = document.querySelector<HTMLElement>("[data-sheet-detail]");
  const close = document.querySelector<HTMLButtonElement>("[data-sheet-close]");

  document.querySelectorAll<HTMLButtonElement>("[data-thing]").forEach((button) => {
    button.addEventListener("click", () => {
      if (!dialog || !title || !action || !detail) return;
      title.textContent = button.dataset.name ?? "";
      action.textContent = button.dataset.action ?? "";
      detail.textContent = button.dataset.detail ?? "";
      dialog.showModal();
    });
  });

  close?.addEventListener("click", () => dialog?.close());

  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
