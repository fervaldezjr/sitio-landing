---
import { site } from "../content/site";
import { hashHref } from "../lib/paths";
---

<header class="masthead">
  <div class="masthead-inner">
    <a class="masthead-brand" href={hashHref("top")}>{site.nav.brand}</a>
    <nav class="masthead-nav" aria-label={site.nav.label}>
      {site.nav.links.map((link) => <a href={hashHref(link.href)}>{link.label}</a>)}
    </nav>
    <a class="masthead-cta" href={hashHref(site.nav.cta.href)}>{site.nav.cta.label}</a>
  </div>
</header>
