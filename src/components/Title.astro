---
import type { Heading } from "../content/site";

/** Two-voice headline: the lead in ink, the rest in grey. Enters line by line (motion.ts). */
interface Props {
  heading: Heading;
  id: string;
  size?: "xl" | "l" | "m";
  class?: string;
  /** The page's main heading uses h1; section headings stay h2. */
  as?: "h1" | "h2";
}

const { heading, id, size = "l", class: extra, as = "h2" } = Astro.props;
const Tag = as;
---

<Tag id={id} class:list={["title", `title-${size}`, extra]} data-lines>
  <span class="voice-1">{heading.lead}</span>{heading.rest ? " " : ""}{heading.rest && <span class="voice-2">{heading.rest}</span>}
</Tag>
