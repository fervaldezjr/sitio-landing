---
import { site } from "../content/site";
import { publicUrl } from "../lib/paths";
import Folio from "./Folio.astro";
import Title from "./Title.astro";

interface Props {
  n: number;
}

const { n } = Astro.props;
const { lists } = site;
const { example } = lists;
---

<section class="chapter" id={lists.id} aria-labelledby="listas-titulo">
  <div class="wrap grid">
    <Folio n={n} label={lists.label} />
    <div class="lists-copy">
      <Title id="listas-titulo" heading={lists.title} size="m" />
      <p class="lede" data-reveal>{lists.body}</p>
    </div>
    <figure class="lists-figure">
      <div class="app-stage" data-unveil>
        <div class="app-card">
          <p class="app-tag">{example.tag}</p>
          <p class="app-title">{example.title}</p>
          <p class="app-meta">{example.meta}</p>
          <ul class="app-items">
            {
              example.items.map((item) => (
                <li class="app-item">
                  <picture>
                    <source srcset={publicUrl(`media/lists/${item.id}.avif`)} type="image/avif" />
                    <source srcset={publicUrl(`media/lists/${item.id}.webp`)} type="image/webp" />
                    <img src={publicUrl(`media/lists/${item.id}.jpg`)} alt="" width="160" height="160" loading="lazy" decoding="async" />
                  </picture>
                  <span class="app-name">{item.name}</span>
                  <span class="app-chips">
                    <span class="app-chip">{example.change}</span>
                    <span class="app-chip">{example.save}</span>
                  </span>
                </li>
              ))
            }
          </ul>
          <p class="app-button">{example.add}</p>
        </div>
      </div>
      <figcaption>{example.caption}</figcaption>
    </figure>
  </div>
</section>
