---
import { copyFor } from "../content/site";
import Title from "./Title.astro";

const site = copyFor(Astro.currentLocale);
---

<section class="section statement" aria-labelledby="statement-titulo">
  <div class="wrap">
    <Title id="statement-titulo" heading={site.statement.title} size="xl" />
  </div>
</section>
